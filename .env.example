# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Worker tuning
WORKER_CONCURRENCY=1
MAX_CONCURRENT_SCRAPES_PER_HOST=2
JOB_RESULT_TTL_SECONDS=86400
MAX_WORKER_MEMORY_MB=3500
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SECONDS=600

# API
SERVICE_ROLE=api
MAX_CONCURRENT_SCRAPES=2

# Chrome (Railway worker)
CHROME_BIN=/usr/bin/google-chrome
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver
FORCE_HEADLESS=true

# Optional proxy (worker service — career browser + HTTP; leave empty for direct)
# PROXY_URLS=http://user:pass@proxy1:port,http://user:pass@proxy2:port
# PROXY_URL=http://user:pass@proxy:port
# PROXY_ROTATION_INTERVAL=240
